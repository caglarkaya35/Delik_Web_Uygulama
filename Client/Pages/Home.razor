@page "/"
@using System.Globalization
@using Shared.Modeller
@using System.Text.Json
@using static Supabase.Postgrest.Constants
@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject Shared.Servisler.DelikHesaplama DelikServisi
@inject Supabase.Client SupabaseClient

<PageTitle>DelikPro – Mobilya Modülü</PageTitle>

<div class="ana-ekran">

    <!-- ÜST MENÜ ÇUBUĞU -->
    <header class="ust-menu">
        <span class="logo-metin">◼ DelikPro</span>
        <nav class="menu-nav">
            <button class="menu-btn @(aktifMenu == "tasarim" ? "aktif" : "")"
                    @onclick='() => aktifMenu = "tasarim"'>TASARIM</button>
            <button class="menu-btn @(aktifMenu == "imalat" ? "aktif" : "")"
                    @onclick='() => aktifMenu = "imalat"'>İMALAT / GÖRÜNÜM</button>
            <button class="menu-btn @(aktifMenu == "veritabani" ? "aktif" : "")"
                    @onclick='() => aktifMenu = "veritabani"'>VERİTABANI</button>
            <button class="menu-btn @(aktifMenu == "yardim" ? "aktif" : "")"
                    @onclick='() => aktifMenu = "yardim"'>YARDIM</button>
        </nav>
    </header>

    <!-- ORTA: SOL PANEL + ÇİZİM ALANI -->
    <div class="orta-alan">

        @if (aktifMenu == "veritabani")
        {
        <aside class="veritabani-sol">
            <p class="sol-baslik">VERİTABANI</p>
            <button class="veritabani-btn @(seciliVeritabaniKategorisi == "proje" ? "aktif" : "")" @onclick='() => seciliVeritabaniKategorisi = "proje"'>
                <MudIcon Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small"/>
                <span>Proje Yönetimi</span>
            </button>
            <button class="veritabani-btn @(seciliVeritabaniKategorisi == "takim" ? "aktif" : "")" @onclick='() => seciliVeritabaniKategorisi = "takim"'>
                <MudIcon Icon="@Icons.Material.Filled.Build" Size="Size.Small"/>
                <span>Takım Ayarları</span>
            </button>
            <button class="veritabani-btn @(seciliVeritabaniKategorisi == "birlestirme" ? "aktif" : "")" @onclick='() => seciliVeritabaniKategorisi = "birlestirme"'>
                <MudIcon Icon="@Icons.Material.Filled.CallMerge" Size="Size.Small"/>
                <span>Birleştirme Ayarları</span>
            </button>
            <button class="veritabani-btn @(seciliVeritabaniKategorisi == "makine" ? "aktif" : "")" @onclick='() => seciliVeritabaniKategorisi = "makine"'>
                <MudIcon Icon="@Icons.Material.Filled.PrecisionManufacturing" Size="Size.Small"/>
                <span>Makine Ayarları</span>
            </button>
            <button class="veritabani-btn @(seciliVeritabaniKategorisi == "parca" ? "aktif" : "")" @onclick='() => seciliVeritabaniKategorisi = "parca"'>
                <MudIcon Icon="@Icons.Material.Filled.Inventory" Size="Size.Small"/>
                <span>Parça Bilgileri</span>
            </button>
            <button class="veritabani-btn @(seciliVeritabaniKategorisi == "koordinat" ? "aktif" : "")" @onclick='() => seciliVeritabaniKategorisi = "koordinat"'>
                <MudIcon Icon="@Icons.Material.Filled.BlurCircular" Size="Size.Small"/>
                <span>Parça Delik Koordinatları</span>
            </button>
            <button class="veritabani-btn @(seciliVeritabaniKategorisi == "rafpimi" ? "aktif" : "")" @onclick='() => seciliVeritabaniKategorisi = "rafpimi"'>
                <MudIcon Icon="@Icons.Material.Filled.LinearScale" Size="Size.Small"/>
                <span>Raf Pimi Ayarları</span>
            </button>
            <button class="veritabani-btn @(seciliVeritabaniKategorisi == "gkodu" ? "aktif" : "")" @onclick='() => seciliVeritabaniKategorisi = "gkodu"'>
                <MudIcon Icon="@Icons.Material.Filled.FileDownload" Size="Size.Small"/>
                <span>G Kodu Çıkarılan Parçalar</span>
            </button>
        </aside>
        
        <main class="imalat-icerik">
            @if (seciliVeritabaniKategorisi == "takim")
            {
                <div class="takim-tablo-konteyner">
                    <div class="takim-ust-baslik">
                        <h2>TAKIM AYARLARI VERİTABANI</h2>
                    </div>
                    <div class="takim-liste-serit">TAKIM LİSTESİ</div>
                    <div class="takim-tablo-sarmal" style="border-radius:0">
                        <table class="takim-tablo">
                            <thead>
                                <tr>
                                    <th>TAKIM NO</th>
                                    <th>TAKIM ADI</th>
                                    <th>TAKIM TİPİ</th>
                                    <th>ÇAP</th>
                                    <th>XY DALMA HIZI</th>
                                    <th>Z DALMA HIZI</th>
                                    <th>XY İLERLEME HIZI</th>
                                    <th>Z İLERLEME HIZI</th>
                                    <th>X OFSET</th>
                                    <th>Y OFSET</th>
                                    <th>Z OFSET</th>
                                    <th>TAKIM UZUNL.</th>
                                    <th>PİSTON AÇMA</th>
                                    <th>PİSTON KAPAT</th>
                                    <th style="width:50px">İŞLEM</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var t in takimlar)
                                {
                                    <tr>
                                        <td class="sayi-kolon">
                                            <MudNumericField @bind-Value="t.No" Margin="Margin.Dense" Variant="Variant.Text" HideSpinButtons="true" Class="tablo-input" OnBlur="VeritabaniniKaydet" />
                                        </td>
                                        <td>
                                            <MudTextField @bind-Value="t.Ad" Margin="Margin.Dense" Variant="Variant.Text" Class="tablo-input" OnBlur="VeritabaniniKaydet" />
                                        </td>
                                        <td>
                                            <MudTextField @bind-Value="t.Tip" Margin="Margin.Dense" Variant="Variant.Text" Class="tablo-input" OnBlur="VeritabaniniKaydet" />
                                        </td>
                                        <td>
                                            <MudNumericField @bind-Value="t.Cap" Margin="Margin.Dense" Variant="Variant.Text" HideSpinButtons="true" Class="tablo-input" OnBlur="VeritabaniniKaydet" />
                                        </td>
                                        <td>
                                            <MudNumericField @bind-Value="t.XYDalmaHizi" Margin="Margin.Dense" Variant="Variant.Text" HideSpinButtons="true" Class="tablo-input" OnBlur="VeritabaniniKaydet" />
                                        </td>
                                        <td>
                                            <MudNumericField @bind-Value="t.ZDalmaHizi" Margin="Margin.Dense" Variant="Variant.Text" HideSpinButtons="true" Class="tablo-input" OnBlur="VeritabaniniKaydet" />
                                        </td>
                                        <td>
                                            <MudNumericField @bind-Value="t.XYIlerlemeHizi" Margin="Margin.Dense" Variant="Variant.Text" HideSpinButtons="true" Class="tablo-input" OnBlur="VeritabaniniKaydet" />
                                        </td>
                                        <td>
                                            <MudNumericField @bind-Value="t.ZIlerlemeHizi" Margin="Margin.Dense" Variant="Variant.Text" HideSpinButtons="true" Class="tablo-input" OnBlur="VeritabaniniKaydet" />
                                        </td>
                                        <td>
                                            <MudNumericField @bind-Value="t.XOfset" Margin="Margin.Dense" Variant="Variant.Text" HideSpinButtons="true" Class="tablo-input" OnBlur="VeritabaniniKaydet" />
                                        </td>
                                        <td>
                                            <MudNumericField @bind-Value="t.YOfset" Margin="Margin.Dense" Variant="Variant.Text" HideSpinButtons="true" Class="tablo-input" OnBlur="VeritabaniniKaydet" />
                                        </td>
                                        <td>
                                            <MudNumericField @bind-Value="t.ZOfset" Margin="Margin.Dense" Variant="Variant.Text" HideSpinButtons="true" Class="tablo-input" OnBlur="VeritabaniniKaydet" />
                                        </td>
                                        <td>
                                            <MudNumericField @bind-Value="t.Uzunluk" Margin="Margin.Dense" Variant="Variant.Text" HideSpinButtons="true" Class="tablo-input" OnBlur="VeritabaniniKaydet" />
                                        </td>
                                        <td>
                                            <MudTextField @bind-Value="t.PistonAcma" Margin="Margin.Dense" Variant="Variant.Text" Class="tablo-input" OnBlur="VeritabaniniKaydet" />
                                        </td>
                                        <td>
                                            <MudTextField @bind-Value="t.PistonKapat" Margin="Margin.Dense" Variant="Variant.Text" Class="tablo-input" OnBlur="VeritabaniniKaydet" />
                                        </td>
                                        <td>
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => TakimSil(t)" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="takim-alt-kontrol">
                        <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" OnClick="TakimEkle">YENİ EKLE</MudButton>
                        <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save" Color="Color.Success" OnClick="VeritabaniniKaydet">VERİTABANINI KAYDET</MudButton>
                    </div>
                </div>
            }
            else if (seciliVeritabaniKategorisi == "birlestirme")
            {
                <div class="takim-tablo-konteyner">
                    <div class="takim-ust-baslik" style="text-align: left; padding-left: 0;">
                        <h2 style="font-size: 24px; color: #444;">Birleştirme Ayarları</h2>
                    </div>

                    <div class="birlestirme-ust-form">
                        <div class="birlestirme-form-satir">
                            <div class="birlestirme-form-alan">
                                <MudSelect T="string" Label="Sistem Tipi" @bind-Value="yeniBirlestirme.SistemTipi" Variant="Variant.Outlined" Margin="Margin.Dense">
                                    <MudSelectItem Value="@("MİNİFİKS")">MİNİFİKS</MudSelectItem>
                                    <MudSelectItem Value="@("VİDA")">VİDA</MudSelectItem>
                                    <MudSelectItem Value="@("RAF PİMİ")">RAF PİMİ</MudSelectItem>
                                </MudSelect>
                            </div>
                            <div class="birlestirme-form-alan">
                                <MudSelect T="string" Label="Kullanım Alanı" @bind-Value="yeniBirlestirme.KullanimAlani" Variant="Variant.Outlined" Margin="Margin.Dense">
                                    <MudSelectItem Value="@("GÖVDE")">GÖVDE</MudSelectItem>
                                    <MudSelectItem Value="@("RAF")">RAF</MudSelectItem>
                                    <MudSelectItem Value="@("DİKME")">DİKME</MudSelectItem>
                                </MudSelect>
                            </div>
                            <div class="birlestirme-form-alan">
                                <MudSelect T="string" Label="İşlem Tipi" @bind-Value="yeniBirlestirme.IslemTipi" Variant="Variant.Outlined" Margin="Margin.Dense">
                                    <MudSelectItem Value="@("ÇANAK")">ÇANAK</MudSelectItem>
                                    <MudSelectItem Value="@("YATAY MİL")">YATAY MİL</MudSelectItem>
                                    <MudSelectItem Value="@("YATAY DÜBEL")">YATAY DÜBEL</MudSelectItem>
                                    <MudSelectItem Value="@("YÜZEY MİL")">YÜZEY MİL</MudSelectItem>
                                    <MudSelectItem Value="@("YÜZEY DÜBEL")">YÜZEY DÜBEL</MudSelectItem>
                                    <MudSelectItem Value="@("RAF_PİMİ")">RAF_PİMİ</MudSelectItem>
                                </MudSelect>
                            </div>
                        </div>
                        <div class="birlestirme-form-satir">
                            <div class="birlestirme-form-alan">
                                <MudNumericField T="double" Label="Çapı" @bind-Value="yeniBirlestirme.Capi" Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" />
                            </div>
                            <div class="birlestirme-form-alan">
                                <MudNumericField T="double" Label="Derinlik" @bind-Value="yeniBirlestirme.Derinlik" Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" />
                            </div>
                            <div class="birlestirme-form-alan">
                                <MudNumericField T="double" Label="X Ofset" @bind-Value="yeniBirlestirme.XOfset" Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" />
                            </div>
                        </div>
                        <div class="birlestirme-form-satir">
                            <div class="birlestirme-form-alan">
                                <MudNumericField T="double" Label="Y Ofset" @bind-Value="yeniBirlestirme.YOfset" Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" />
                            </div>
                            <div class="birlestirme-form-alan">
                                <MudNumericField T="double" Label="Z Ofset" @bind-Value="yeniBirlestirme.ZOfset" Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" />
                            </div>
                            <div class="birlestirme-form-alan" style="display:flex; align-items:flex-end; justify-content:flex-end; gap:8px;">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="BirlestirmeEkle" Size="Size.Small" Style="background-color: #673ab7; color: white;">Ekle</MudButton>
                                <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="VeritabaniniKaydet" Size="Size.Small" Style="background-color: #673ab7; color: white;">Güncelle</MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="BirlestirmeFormdanSil" Size="Size.Small">Sil</MudButton>
                            </div>
                        </div>
                    </div>

                    <div class="birlestirme-tablo-sarmal">
                        <table class="takim-tablo">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Sistem Tipi</th>
                                    <th>Kullanım Alanı</th>
                                    <th>İşlem Tipi</th>
                                    <th>Çapı</th>
                                    <th>Derinlik</th>
                                    <th>X Ofset</th>
                                    <th>Y Ofset</th>
                                    <th>Z Ofset</th>
                                    <th style="width:50px">İŞLEM</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var b in birlestirmeler)
                                {
                                    <tr @onclick="() => BirlestirmeSec(b)" style="cursor: pointer; background: @(seciliBirlestirmeId == b.Id ? "#f3e5f5" : "transparent")">
                                        <td>@b.Id</td>
                                        <td>@b.SistemTipi</td>
                                        <td>@b.KullanimAlani</td>
                                        <td>@b.IslemTipi</td>
                                        <td>@b.Capi.ToString("F2")</td>
                                        <td>@b.Derinlik.ToString("F2")</td>
                                        <td>@b.XOfset.ToString("F2")</td>
                                        <td>@b.YOfset.ToString("F2")</td>
                                        <td>@b.ZOfset.ToString("F2")</td>
                                        <td>
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => BirlestirmeSil(b)" OnClick:stopPropagation="true" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else if (seciliVeritabaniKategorisi == "makine")
            {
                <div class="takim-tablo-konteyner">
                    <div class="takim-ust-baslik" style="text-align: left; padding-left: 0;">
                        <h2 style="font-size: 24px; color: #444;">Makina Ayarları</h2>
                    </div>

                    <div class="takim-tablo-sarmal" style="border-radius: 8px;">
                        <table class="takim-tablo">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Makina Adı</th>
                                    <th>X Ekseni Limiti (mm)</th>
                                    <th>Y Ekseni Limiti (mm)</th>
                                    <th>Emniyet Mesafesi (mm)</th>
                                    <th>Hız</th>
                                    <th style="width:50px">İŞLEM</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var m in makineler)
                                {
                                    <tr>
                                        <td>
                                            <MudNumericField @bind-Value="m.Id" Margin="Margin.Dense" Variant="Variant.Text" HideSpinButtons="true" Class="tablo-input" @bind-Value:after="VeritabaniniKaydet" />
                                        </td>
                                        <td>
                                            <MudTextField @bind-Value="m.Ad" Margin="Margin.Dense" Variant="Variant.Text" Class="tablo-input" @bind-Value:after="VeritabaniniKaydet" />
                                        </td>
                                        <td>
                                            <MudNumericField @bind-Value="m.XEkseniLimiti" Margin="Margin.Dense" Variant="Variant.Text" HideSpinButtons="true" Class="tablo-input" @bind-Value:after="VeritabaniniKaydet" />
                                        </td>
                                        <td>
                                            <MudNumericField @bind-Value="m.YEkseniLimiti" Margin="Margin.Dense" Variant="Variant.Text" HideSpinButtons="true" Class="tablo-input" @bind-Value:after="VeritabaniniKaydet" />
                                        </td>
                                        <td>
                                            <MudNumericField @bind-Value="m.EmniyetMesafesi" Margin="Margin.Dense" Variant="Variant.Text" HideSpinButtons="true" Class="tablo-input" @bind-Value:after="VeritabaniniKaydet" />
                                        </td>
                                        <td>
                                            <MudNumericField @bind-Value="m.Hiz" Margin="Margin.Dense" Variant="Variant.Text" HideSpinButtons="true" Class="tablo-input" @bind-Value:after="VeritabaniniKaydet" />
                                        </td>
                                        <td>
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => MakineSil(m)" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="takim-alt-kontrol" style="background: transparent; border: none; padding-right: 0;">
                        <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" OnClick="MakineEkle" Size="Size.Small" Style="background-color: #7b1fa2;">YENİ EKLE</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="VeritabaniniKaydet" Size="Size.Small" Style="background-color: #7b1fa2;">Kaydet</MudButton>
                    </div>
                </div>
            }
            else if (seciliVeritabaniKategorisi == "koordinat")
            {
                <div class="takim-tablo-konteyner">
                    <div class="takim-ust-baslik" style="text-align: left; padding-left: 0;">
                        <h2 style="font-size: 24px; color: #444;">Parça Delik Koordinatları</h2>
                    </div>
                    <div class="takim-tablo-sarmal" style="border-radius: 8px;">
                        <table class="takim-tablo">
                            <thead>
                                <tr>
                                    <th>PARÇA ADI</th>
                                    <th>DELİK TİPİ</th>
                                    <th>X KOORDİNAT</th>
                                    <th>Y KOORDİNAT</th>
                                    <th>Z KOORDİNAT</th>
                                    <th>ÇAP</th>
                                    <th>DERİNLİK</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (parcaDelikKoordinatlari.Count == 0)
                                {
                                    <tr>
                                        <td colspan="7" style="text-align:center; color:#888; padding:16px;">
                                            Henüz kayıt yok. İmalat Resmi Oluştur → VERİTABANINA KAYDET ile doldurulur.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var k in parcaDelikKoordinatlari)
                                    {
                                        <tr>
                                            <td>@k.ParcaAdi</td>
                                            <td>@k.DelikTipi</td>
                                            <td>@k.YKoordinat.ToString("F2")</td>
                                            <td>@k.XKoordinat.ToString("F2")</td>
                                            <td>@k.ZKoordinat.ToString("F2")</td>
                                            <td>@k.Cap.ToString("F2")</td>
                                            <td>@k.Derinlik.ToString("F2")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else if (seciliVeritabaniKategorisi == "rafpimi")
            {
                <div class="takim-tablo-konteyner">
                    <div class="takim-ust-baslik" style="text-align: left; padding-left: 0;">
                        <h2 style="font-size: 24px; color: #444;">Raf Pimi Ayarları</h2>
                    </div>

                    <div class="birlestirme-ust-form">
                        <div class="birlestirme-form-satir">
                            <div class="birlestirme-form-alan">
                                <MudNumericField Label="Dikey Aralık Limiti (mm)" @bind-Value="rafPimiAyari.DikeyAralikLimiti" Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" />
                            </div>
                            <div class="birlestirme-form-alan">
                                <MudNumericField Label="Ön Kenar Ofset (mm)" @bind-Value="rafPimiAyari.OnKenarOfset" Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" />
                            </div>
                        </div>
                        <div class="birlestirme-form-satir">
                            <div class="birlestirme-form-alan">
                                <MudNumericField Label="Arka Kenar Ofset (mm)" @bind-Value="rafPimiAyari.ArkaKenarOfset" Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" />
                            </div>
                            <div class="birlestirme-form-alan">
                                <MudNumericField Label="Delik Çapı (mm)" @bind-Value="rafPimiAyari.DelikCapi" Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" />
                            </div>
                        </div>
                        <div class="birlestirme-form-satir">
                            <div class="birlestirme-form-alan">
                                <MudNumericField Label="Delik Derinliği (mm)" @bind-Value="rafPimiAyari.DelikDerinligi" Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" />
                            </div>
                            <div class="birlestirme-form-alan">
                                <MudSelect T="string" Label="Yerleşim Tipi" @bind-Value="rafPimiAyari.YerlesimTipi" Variant="Variant.Outlined" Margin="Margin.Dense">
                                    <MudSelectItem Value="@("Raf Konumuna Göre")">Raf Konumuna Göre</MudSelectItem>
                                    <MudSelectItem Value="@("Eşit Aralıklı")">Eşit Aralıklı</MudSelectItem>
                                </MudSelect>
                            </div>
                        </div>
                        <div class="birlestirme-form-satir">
                            <div class="birlestirme-form-alan">
                                <MudNumericField Label="Delik Sırası Adedi" @bind-Value="rafPimiAyari.DelikSirasiAdedi" Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" />
                            </div>
                            <div class="birlestirme-form-alan" style="display:flex; align-items:flex-end; justify-content:flex-end;">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="VeritabaniniKaydet" Style="background-color: #7b1fa2;">Kaydet</MudButton>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <p>Sol panelden bir kategori seçin</p>
            }
        </main>
        }
        else
        {
        @if (aktifMenu == "imalat")
        {
        <aside class="imalat-sol">
            <p class="sol-baslik">İMALAT</p>
            <button class="imalat-btn" @onclick="PatlatilmisGorunumuBaslat">
                <MudIcon Icon="@Icons.Material.Filled.Engineering" Size="Size.Large"/>
                <span>İmalat Resmi Oluştur</span>
            </button>
            <div class="sol-ayrac"></div>
            <button class="imalat-btn">
                <MudIcon Icon="@Icons.Material.Filled.QrCode" Size="Size.Large"/>
                <span>Barkod Oluştur</span>
            </button>
            <div class="sol-ayrac"></div>
            <button class="imalat-btn">
                <MudIcon Icon="@Icons.Material.Filled.GridOn" Size="Size.Large"/>
                <span>Nesting Yap</span>
            </button>
            <div class="sol-ayrac"></div>
            <button class="imalat-btn">
                <MudIcon Icon="@Icons.Material.Filled.Code" Size="Size.Large"/>
                <span>G Kodu Simülasyon Yap</span>
            </button>
        </aside>
        }
        else
        {
        <!-- SOL PANEL -->
        <aside class="sol-panel">
            <div class="sol-kaydet-ac">
                <MudTooltip Text="Kaydet" Placement="Placement.Right">
                    <MudIconButton Icon="@Icons.Material.Filled.Save"
                                   Size="Size.Small" OnClick="KaydetTiklandi"
                                   Class="sol-ikon-btn" />
                </MudTooltip>
                <MudTooltip Text="Aç" Placement="Placement.Right">
                    <MudIconButton Icon="@Icons.Material.Filled.FolderOpen"
                                   Size="Size.Small" OnClick="AcTiklandi"
                                   Class="sol-ikon-btn" />
                </MudTooltip>
            </div>
            <div class="sol-ayrac" style="margin:0 12px 6px"></div>
            <p class="sol-baslik">ARAÇLAR</p>

            <button class="sol-btn" @onclick="RafEkle">
                <MudIcon Icon="@Icons.Material.Filled.TableRows" Size="Size.Small" />
                Raf Ekle
            </button>
            <button class="sol-btn" @onclick="DikmeEkle">
                <MudIcon Icon="@Icons.Material.Filled.ViewColumn" Size="Size.Small" />
                Dikme Ekle
            </button>

            @if (rafSayisi > 0 || dikmeSayisi > 0)
            {
                <div class="sol-ayrac"></div>
                <p class="sol-bilgi">Raf: <strong>@rafSayisi</strong></p>
                <p class="sol-bilgi">Dikme: <strong>@dikmeSayisi</strong></p>
                <button class="sol-btn sol-sil" @onclick="Temizle">
                    <MudIcon Icon="@Icons.Material.Filled.DeleteSweep" Size="Size.Small" />
                    Temizle
                </button>
            }
        </aside>
        }

        <!-- ÇİZİM ALANI -->
        <main class="cizim-kap" style="position:relative">
            @if (patlatmaFaktoru > 0)
            {
                <div class="imalat-islem-bar">
                    <button class="imalat-islem-btn btn-db-kaydet" @onclick="ImalatVeritabaninaKaydet">VERİTABANINA KAYDET</button>
                    <button class="imalat-islem-btn btn-nest-ekle">NESTING HAVUZUNA EKLE</button>
                    <button class="imalat-islem-btn btn-gkod-cikar" @onclick="GKoduCikar">G KODU ÇIKAR</button>
                    <button class="imalat-islem-btn btn-qr-cikar">QR KODU ÇIKAR</button>
                    <button class="imalat-islem-btn btn-imalat-kapat" @onclick="CizimiKapat">KAPAT</button>
                </div>
            }
            @if (!gorunum3D)
            {
            <svg viewBox="0 0 800 600"
                 xmlns="http://www.w3.org/2000/svg"
                 style="width:100%;height:100%;display:block"
                 @onwheel="OnWheel2d" @onwheel:preventDefault>
                <defs>
                    <pattern id="kucukIzgara" width="20" height="20" patternUnits="userSpaceOnUse">
                        <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#dde5ee" stroke-width="0.5" />
                    </pattern>
                    <pattern id="buyukIzgara" width="100" height="100" patternUnits="userSpaceOnUse">
                        <rect width="100" height="100" fill="url(#kucukIzgara)" />
                        <path d="M 100 0 L 0 0 0 100" fill="none" stroke="#c4cfdb" stroke-width="1" />
                    </pattern>
                </defs>

                <!-- Arka plan + ızgara -->
                <rect width="800" height="600" fill="#f2f6fb" />
                <rect width="800" height="600" fill="url(#buyukIzgara)" />

                <g transform="translate(400,300) scale(@N(zoom2d)) translate(-400,-300)">
                @{
                    var dp  = DolapHesapla();
                    double iX = dp.X + dp.K;
                    double iY = dp.Y + dp.K;
                    double iW = dp.W - dp.K * 2;
                    double iH = dp.H - dp.K * 2;
                    string yRot = $"rotate(-90,{N(dp.X - 38)},{N(dp.Y + dp.H / 2)})";
                }

@* ── Paneller: montaj tipine göre köşe birleşimleri ──
                   SVG'de son çizilen öne gelir (painter's algorithm).
                   "Dışarıda" olan panel her zaman son çizilir. *@

                @if (montajTipi == "Alt-Üst İçeride")
                {
                    @* Üst & alt içeride → yanlar tam boy, en son çizilir *@
                    <rect x="@N(iX)"  y="@N(dp.Y)"              width="@N(iW)"  height="@N(dp.K)" fill="#ffeb3b" stroke="#666" stroke-width="1"/>
                    <rect x="@N(iX)"  y="@N(dp.Y+dp.H-dp.K)"   width="@N(iW)"  height="@N(dp.K)" fill="#ffeb3b" stroke="#666" stroke-width="1"/>
                    <rect x="@N(dp.X)"           y="@N(dp.Y)"   width="@N(dp.K)" height="@N(dp.H)" fill="#e53935" stroke="#666" stroke-width="1"/>
                    <rect x="@N(dp.X+dp.W-dp.K)" y="@N(dp.Y)"   width="@N(dp.K)" height="@N(dp.H)" fill="#e53935" stroke="#666" stroke-width="1"/>
                }
                else if (montajTipi == "Alt-Üst Dışarıda")
                {
                    @* Yanlar içeride → üst & alt tam genişlik, en son çizilir *@
                    <rect x="@N(dp.X)"           y="@N(iY)"  width="@N(dp.K)" height="@N(dp.H-dp.K*2)" fill="#e53935" stroke="#666" stroke-width="1"/>
                    <rect x="@N(dp.X+dp.W-dp.K)" y="@N(iY)"  width="@N(dp.K)" height="@N(dp.H-dp.K*2)" fill="#e53935" stroke="#666" stroke-width="1"/>
                    <rect x="@N(dp.X)" y="@N(dp.Y)"            width="@N(dp.W)" height="@N(dp.K)" fill="#ffeb3b" stroke="#666" stroke-width="1"/>
                    <rect x="@N(dp.X)" y="@N(dp.Y+dp.H-dp.K)"  width="@N(dp.W)" height="@N(dp.K)" fill="#ffeb3b" stroke="#666" stroke-width="1"/>
                }
                else if (montajTipi == "Alt İçeride-Üst Dışarıda")
                {
                    @* Alt içeride, yanlar alttan tam boya iner; üst tam genişlik son çizilir *@
                    <rect x="@N(iX)"  y="@N(dp.Y+dp.H-dp.K)"   width="@N(iW)"  height="@N(dp.K)" fill="#ffeb3b" stroke="#666" stroke-width="1"/>
                    <rect x="@N(dp.X)"           y="@N(iY)"  width="@N(dp.K)" height="@N(dp.H-dp.K)" fill="#e53935" stroke="#666" stroke-width="1"/>
                    <rect x="@N(dp.X+dp.W-dp.K)" y="@N(iY)"  width="@N(dp.K)" height="@N(dp.H-dp.K)" fill="#e53935" stroke="#666" stroke-width="1"/>
                    <rect x="@N(dp.X)" y="@N(dp.Y)"             width="@N(dp.W)" height="@N(dp.K)" fill="#ffeb3b" stroke="#666" stroke-width="1"/>
                }
                else
                {
                    @* Alt Dışarıda-Üst İçeride: üst içeride, yanlar üstten tam boya iner; alt tam genişlik son çizilir *@
                    <rect x="@N(iX)"  y="@N(dp.Y)"              width="@N(iW)"  height="@N(dp.K)" fill="#ffeb3b" stroke="#666" stroke-width="1"/>
                    <rect x="@N(dp.X)"           y="@N(dp.Y)"  width="@N(dp.K)" height="@N(dp.H-dp.K)" fill="#e53935" stroke="#666" stroke-width="1"/>
                    <rect x="@N(dp.X+dp.W-dp.K)" y="@N(dp.Y)"  width="@N(dp.K)" height="@N(dp.H-dp.K)" fill="#e53935" stroke="#666" stroke-width="1"/>
                    <rect x="@N(dp.X)" y="@N(dp.Y+dp.H-dp.K)"  width="@N(dp.W)" height="@N(dp.K)" fill="#ffeb3b" stroke="#666" stroke-width="1"/>
                }

                <!-- Dış çerçeve -->
                <rect x="@N(dp.X)" y="@N(dp.Y)"
                      width="@N(dp.W)" height="@N(dp.H)"
                      fill="none" stroke="#352006" stroke-width="1.5" />

                <!-- Raflar -->
                @for (int i = 1; i <= rafSayisi; i++)
                {
                    double rafY = iY + (i / (double)(rafSayisi + 1)) * iH - dp.K / 2;
                    <rect x="@N(iX)" y="@N(rafY)"
                          width="@N(iW)" height="@N(dp.K)"
                          fill="#c9953a" stroke="#6b4710" stroke-width="0.5" />
                }

                <!-- Dikmeler -->
                @for (int i = 1; i <= dikmeSayisi; i++)
                {
                    double dikmeX = iX + (i / (double)(dikmeSayisi + 1)) * iW - dp.K / 2;
                    <rect x="@N(dikmeX)" y="@N(iY)"
                          width="@N(dp.K)" height="@N(iH)"
                          fill="#c9953a" stroke="#6b4710" stroke-width="0.5" />
                }

                <!-- Genişlik ölçü çizgisi -->
                <line x1="@N(dp.X)" y1="@N(dp.Y + dp.H + 24)"
                      x2="@N(dp.X + dp.W)" y2="@N(dp.Y + dp.H + 24)"
                      stroke="#5a6478" stroke-width="1.5" />
                <line x1="@N(dp.X)" y1="@N(dp.Y + dp.H + 15)"
                      x2="@N(dp.X)" y2="@N(dp.Y + dp.H + 33)"
                      stroke="#5a6478" stroke-width="1.5" />
                <line x1="@N(dp.X + dp.W)" y1="@N(dp.Y + dp.H + 15)"
                      x2="@N(dp.X + dp.W)" y2="@N(dp.Y + dp.H + 33)"
                      stroke="#5a6478" stroke-width="1.5" />
                <text x="@N(dp.X + dp.W / 2)" y="@N(dp.Y + dp.H + 46)"
                      text-anchor="middle" font-size="12" fill="#5a6478"
                      font-family="Roboto,sans-serif">@genislik mm</text>

                <!-- Yükseklik ölçü çizgisi -->
                <line x1="@N(dp.X - 24)" y1="@N(dp.Y)"
                      x2="@N(dp.X - 24)" y2="@N(dp.Y + dp.H)"
                      stroke="#5a6478" stroke-width="1.5" />
                <line x1="@N(dp.X - 15)" y1="@N(dp.Y)"
                      x2="@N(dp.X - 33)" y2="@N(dp.Y)"
                      stroke="#5a6478" stroke-width="1.5" />
                <line x1="@N(dp.X - 15)" y1="@N(dp.Y + dp.H)"
                      x2="@N(dp.X - 33)" y2="@N(dp.Y + dp.H)"
                      stroke="#5a6478" stroke-width="1.5" />
                <text x="@N(dp.X - 38)" y="@N(dp.Y + dp.H / 2)"
                      text-anchor="middle" font-size="12" fill="#5a6478"
                      font-family="Roboto,sans-serif"
                      transform="@yRot">@yukseklik mm</text>

                </g>
                @{ double g2Sz = 36; double g2Cx = 66; double g2Cy = 546; }
                <circle cx="@N(g2Cx)" cy="@N(g2Cy)" r="@N(g2Sz+10)" fill="rgba(255,255,255,0.7)" stroke="#c8d0dc" stroke-width="0.8"/>
                <line x1="@N(g2Cx)" y1="@N(g2Cy)" x2="@N(g2Cx+g2Sz)" y2="@N(g2Cy)" stroke="#e53935" stroke-width="2.5" stroke-linecap="round"/>
                <text x="@N(g2Cx+g2Sz+9)" y="@N(g2Cy+4)" font-size="10" fill="#e53935" font-family="Roboto,sans-serif" font-weight="700">X</text>
                <line x1="@N(g2Cx)" y1="@N(g2Cy)" x2="@N(g2Cx)" y2="@N(g2Cy-g2Sz)" stroke="#43a047" stroke-width="2.5" stroke-linecap="round"/>
                <text x="@N(g2Cx)" y="@N(g2Cy-g2Sz-7)" font-size="10" fill="#43a047" font-family="Roboto,sans-serif" font-weight="700" text-anchor="middle">Y</text>
                <circle cx="@N(g2Cx)" cy="@N(g2Cy)" r="3" fill="#37474f"/>
            </svg>
            }
            else
            {
            <svg viewBox="0 0 800 600"
                 xmlns="http://www.w3.org/2000/svg"
                 style="width:100%;height:100%;display:block;cursor:@(arrDragging?"grabbing":"grab")"
                 @onmousedown="Md3d" @onmousemove="Mm3d" @onmouseup="Mu3d" @onmouseleave="Mu3d"
                 @onwheel="OnWheel3d" @onwheel:preventDefault>
                <rect width="800" height="600" fill="#f0f4f8"/>
                <g transform="translate(400,300) scale(@N(zoom3d * (patlatmaFaktoru > 0 ? 0.7 : 1.0))) translate(-400,-300)">
                @foreach (var yuz in Yuzler3d())
                {
                    <polygon points="@PtsStr(yuz)" fill="@yuz.Fill" stroke="@yuz.Stroke" stroke-width="@N(yuz.Sw)"/>
                    
                    @if (yuz.Delikler != null)
                    {
                        @foreach (var delik in yuz.Delikler)
                        {
                            string dRenk = delik.Tip switch {
                                "C"  => "#1565C0",
                                "M"  => "#E65100",
                                "D"  => "#2E7D32",
                                "SM" => "#6A1B9A",
                                "SD" => "#00695C",
                                _    => "#444"
                            };
                            double hr = Math.Max(delik.R, 2.5);
                            double cl = hr * 0.65;
                            <circle cx="@N(delik.X)" cy="@N(delik.Y)" r="@N(hr)"
                                    fill="rgba(255,255,255,0.55)" stroke="@dRenk" stroke-width="1.2"
                                    stroke-dasharray="@(delik.IsThrough ? "2,1.5" : "none")" />
                            <line x1="@N(delik.X-cl)" y1="@N(delik.Y)" x2="@N(delik.X+cl)" y2="@N(delik.Y)"
                                  stroke="@dRenk" stroke-width="0.8"/>
                            <line x1="@N(delik.X)" y1="@N(delik.Y-cl)" x2="@N(delik.X)" y2="@N(delik.Y+cl)"
                                  stroke="@dRenk" stroke-width="0.8"/>
                            @if (nestingFaktoru > 60)
                            {
                                string tipEtk = delik.Tip switch {
                                    "C"  => "Ç",
                                    "M"  => "YtM",
                                    "D"  => "YtD",
                                    "SM" => "YzM",
                                    "SD" => "YzD",
                                    _    => ""
                                };
                                <g>
                                    <text x="@N(delik.X)" y="@N(delik.Y - hr - 1.5)"
                                          text-anchor="middle" font-size="5.5" fill="@dRenk" font-weight="700"
                                          style="pointer-events:none;font-family:Roboto,sans-serif">@tipEtk</text>
                                </g>
                            }
                        }
                    }

                    @if (nestingFaktoru > 10)
                    {
                        @if (!string.IsNullOrEmpty(yuz.Label))
                        {
                            double tx = yuz.Xs.Average();
                            double ty = yuz.Ys.Average();
                            <g>
                                <text x="@N(tx)" y="@N(ty - 5)" text-anchor="middle" font-size="14" fill="#000" font-weight="900"
                                      style="pointer-events:none; font-family: 'Roboto', sans-serif; text-transform: uppercase;">
                                    @yuz.Label
                                </text>
                                <text x="@N(tx)" y="@N(ty + 12)" text-anchor="middle" font-size="11" fill="#333"
                                      style="pointer-events:none; font-family: 'Roboto', sans-serif; font-weight: 700;">
                                    @N(yuz.W) x @N(yuz.H) mm
                                </text>
                            </g>
                        }
                    }
                }
                </g>
                @{
                    double gSz = 36; double gCx = 66; double gCy = 546;
                    double cosY2 = Math.Cos(rotY3d), sinY2 = Math.Sin(rotY3d);
                    double cosX2 = Math.Cos(rotX3d), sinX2 = Math.Sin(rotX3d);
                    double axXsx = cosY2 * gSz,  axXsy = -sinY2 * sinX2 * gSz;
                    double axYsx = 0,              axYsy = -cosX2 * gSz;
                    double axZsx = sinY2 * gSz,   axZsy = cosY2 * sinX2 * gSz;
                }
                <circle cx="@N(gCx)" cy="@N(gCy)" r="@N(gSz+10)" fill="rgba(255,255,255,0.7)" stroke="#c8d0dc" stroke-width="0.8"/>
                <line x1="@N(gCx)" y1="@N(gCy)" x2="@N(gCx+axXsx)" y2="@N(gCy+axXsy)" stroke="#e53935" stroke-width="2.5" stroke-linecap="round"/>
                <text x="@N(gCx+axXsx*1.25)" y="@N(gCy+axXsy*1.25+4)" font-size="10" fill="#e53935" font-family="Roboto,sans-serif" font-weight="700" text-anchor="middle">X</text>
                <line x1="@N(gCx)" y1="@N(gCy)" x2="@N(gCx+axYsx)" y2="@N(gCy+axYsy)" stroke="#43a047" stroke-width="2.5" stroke-linecap="round"/>
                <text x="@N(gCx+axYsx*1.25)" y="@N(gCy+axYsy*1.25+4)" font-size="10" fill="#43a047" font-family="Roboto,sans-serif" font-weight="700" text-anchor="middle">Y</text>
                <line x1="@N(gCx)" y1="@N(gCy)" x2="@N(gCx+axZsx)" y2="@N(gCy+axZsy)" stroke="#1565c0" stroke-width="2.5" stroke-linecap="round"/>
                <text x="@N(gCx+axZsx*1.25)" y="@N(gCy+axZsy*1.25+4)" font-size="10" fill="#1565c0" font-family="Roboto,sans-serif" font-weight="700" text-anchor="middle">Z</text>
                <circle cx="@N(gCx)" cy="@N(gCy)" r="3" fill="#37474f"/>
                @if (nestingFaktoru > 80)
                {
                    var efSatirlar = new (string Renk, string Etiket)[] {
                        ("#1565C0", "Ç  — Çanak"),
                        ("#E65100", "YtM — Yatay Mil"),
                        ("#2E7D32", "YtD — Yatay Dübel"),
                        ("#6A1B9A", "YzM — Yüzey Mil"),
                        ("#00695C", "YzD — Yüzey Dübel"),
                    };
                    double efX = 680; double efY0 = 420;
                    <rect x="@N(efX-8)" y="@N(efY0-14)" width="118" height="@N(efSatirlar.Length*16+10)"
                          fill="rgba(255,255,255,0.82)" stroke="#bbb" stroke-width="0.8" rx="3"/>
                    <g>
                        <text x="@N(efX+51)" y="@N(efY0-2)" text-anchor="middle" font-size="7.5" fill="#555"
                              font-weight="700" font-family="Roboto,sans-serif">DELİK TİPLERİ</text>
                    </g>
                    @for (int ei = 0; ei < efSatirlar.Length; ei++)
                    {
                        double ey = efY0 + 10 + ei * 16;
                        <circle cx="@N(efX)" cy="@N(ey)" r="4.5"
                                fill="rgba(255,255,255,0.55)" stroke="@efSatirlar[ei].Renk" stroke-width="1.2"/>
                        <line x1="@N(efX-3)" y1="@N(ey)" x2="@N(efX+3)" y2="@N(ey)"
                              stroke="@efSatirlar[ei].Renk" stroke-width="0.8"/>
                        <line x1="@N(efX)" y1="@N(ey-3)" x2="@N(efX)" y2="@N(ey+3)"
                              stroke="@efSatirlar[ei].Renk" stroke-width="0.8"/>
                        <g>
                            <text x="@N(efX+10)" y="@N(ey+3.5)" font-size="8" fill="@efSatirlar[ei].Renk"
                                  font-weight="600" font-family="Roboto,sans-serif">@efSatirlar[ei].Etiket</text>
                        </g>
                    }
                }
                <text x="400" y="22" text-anchor="middle" font-size="11" fill="#7b1fa2"
                      font-family="Roboto,sans-serif" font-weight="700" letter-spacing="1">3D GÖRÜNÜM — fareyi sürükle: döndür</text>
                <text x="400" y="40" text-anchor="middle" font-size="10" fill="#9c27b0"
                      font-family="Roboto,sans-serif" font-weight="500">
                    Bakiş: @PerspektifEtiketi() | X @N(rotX3d * 180 / Math.PI)°, Y @N(rotY3d * 180 / Math.PI)°
                </text>
            </svg>

            <div class="view-cube-container">
                <div class="cube-row">
                    <button class="view-btn" @onclick='() => SetView(0, 0)'>ÖN</button>
                    <button class="view-btn" @onclick='() => SetView(0, Math.PI)'>ARKA</button>
                </div>
                <div class="cube-row">
                    <button class="view-btn" @onclick='() => SetView(0, Math.PI/2)'>SOL</button>
                    <button class="view-btn" @onclick='() => SetView(0, -Math.PI/2)'>SAĞ</button>
                </div>
                <div class="cube-row">
                    <button class="view-btn" @onclick='() => SetView(Math.PI/2, 0)'>ÜST</button>
                    <button class="view-btn" @onclick='() => SetView(-Math.PI/2, 0)'>ALT</button>
                </div>
                <div class="cube-row">
                    <button class="view-btn" style="width:102px" @onclick='() => SetView(0.5, -0.785)'>İzometrik</button>
                </div>
            </div>
            }
        </main>

        <!-- SAĞ PANEL -->
        <aside class="sag-panel">
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" FullWidth="true"
                       Size="Size.Small"
                       StartIcon="@(gorunum3D ? Icons.Material.Filled.CropSquare : Icons.Material.Filled.ViewInAr)"
                       OnClick="GorunumDegistir" Class="sag-btn">
                @(gorunum3D ? "2D GÖRÜNÜME GEÇ" : "3D GÖRÜNÜME GEÇ")
            </MudButton>

            @if (aktifMenu == "tasarim")
            {
            <div class="sag-ayrac"></div>

            <MudButton Variant="Variant.Outlined" FullWidth="true"
                       Size="Size.Small" StartIcon="@Icons.Material.Filled.FolderOpen"
                       Class="sag-btn">PROJE AÇ</MudButton>

            <MudButton Variant="Variant.Outlined" FullWidth="true"
                       Size="Size.Small" StartIcon="@Icons.Material.Filled.AddBox"
                       Class="sag-btn">YENİ MODÜL</MudButton>

            <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true"
                       Size="Size.Small" StartIcon="@Icons.Material.Filled.PlaylistAdd"
                       Class="sag-btn">MODÜLÜ PROJEYE EKLE</MudButton>
            }
        </aside>
        }
    </div>

    @if (aktifMenu != "imalat" && aktifMenu != "veritabani")
    {
    <!-- ALT BİLGİ PANELİ -->
    <footer class="alt-panel">
        <div class="alt-satir">
            <div class="giris-kutu">
                <MudNumericField T="double" @bind-Value="genislik"
                                 Label="GENİŞLİK" Variant="Variant.Outlined"
                                 Margin="Margin.Dense" HideSpinButtons="true"
                                 Adornment="Adornment.End" AdornmentText="mm"
                                 Immediate="true" Min="1" />
            </div>
            <div class="giris-kutu">
                <MudNumericField T="double" @bind-Value="yukseklik"
                                 Label="YÜKSEKLİK" Variant="Variant.Outlined"
                                 Margin="Margin.Dense" HideSpinButtons="true"
                                 Adornment="Adornment.End" AdornmentText="mm"
                                 Immediate="true" Min="1" />
            </div>
            <div class="giris-kutu">
