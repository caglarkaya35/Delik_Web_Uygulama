    private List<Yuz3d> Yuzler3d()
    {
        double W = genislik, H = yukseklik, D = derinlik, K = kalinlikMm;
        double cx = W / 2, cy = H / 2, cz = D / 2;
        const double svgW = 800, svgH = 600;
        double scale = Math.Min(svgW, svgH) * 0.32 / Math.Max(W, Math.Max(H, D));
        double cosY = Math.Cos(rotY3d), sinY = Math.Sin(rotY3d);
        double cosX = Math.Cos(rotX3d), sinX = Math.Sin(rotX3d);

        (double sx, double sy, double sz) Proj(double x, double y, double z, double ox = 0, double oy = 0, double oz = 0, double nx = 0, double nz = 0, string tip = "")
        {
            double nestT = nestingFaktoru / 100.0;
            
            double dx3d = (x + ox * patlatmaFaktoru) - cx;
            double dy3d = (y + oy * patlatmaFaktoru) - cy;
            double dz3d = (z + oz * patlatmaFaktoru) - cz;

            double dxNest = 0, dyNest = 0, dzNest = 0;
            if (tip == "yatay") {
                dxNest = (z - cz) + (nz * D * 1.05);
                dzNest = (x - cx) + (nx * W * 1.05);
                dyNest = 0;
            } else if (tip == "dikey_yan") {
                double xRaw = (z - cz) + (nx * W * 1.05);
                double zRaw = -(y - cy) + (nz * D * 1.05);
                dxNest = xRaw * cosY - zRaw * sinY;
                dzNest = xRaw * sinY + zRaw * cosY;
                dyNest = 0;
            } else {
                dxNest = dx3d; dyNest = dy3d; dzNest = dz3d;
            }

            double dx = dx3d * (1 - nestT) + dxNest * nestT;
            double dy = dy3d * (1 - nestT) + dyNest * nestT;
            double dz = dz3d * (1 - nestT) + dzNest * nestT;
            
            double x1 = dx * cosY + dz * sinY, z1 = -dx * sinY + dz * cosY;
            double y2 = dy * cosX - z1 * sinX, z2 = dy * sinX + z1 * cosX;
            return (x1 * scale + svgW / 2, -y2 * scale + svgH / 2, z2);
        }

        var list = new List<Yuz3d>();
        void Ekle(string fill, string stroke, double sw, string lbl, double pW, double pH,
                  (double x, double y, double z) p0, (double x, double y, double z) p1,
                  (double x, double y, double z) p2, (double x, double y, double z) p3,
                  double ox = 0, double oy = 0, double oz = 0, double nx = 0, double nz = 0, string tip = "",
                  List<(double x, double y, double z, double r, string t, double d)> rawHoles = null)
        {
            var pts = new[] { Proj(p0.x,p0.y,p0.z, ox, oy, oz, nx, nz, tip), Proj(p1.x,p1.y,p1.z, ox, oy, oz, nx, nz, tip),
                              Proj(p2.x,p2.y,p2.z, ox, oy, oz, nx, nz, tip), Proj(p3.x,p3.y,p3.z, ox, oy, oz, nx, nz, tip) };

            List<DelikSVG> projectedHoles = null;
            if (rawHoles != null)
            {
                projectedHoles = rawHoles.Select(h => {
                    var p = Proj(h.x, h.y, h.z, ox, oy, oz, nx, nz, tip);
                    return new DelikSVG(p.sx, p.sy, Math.Max(h.r * scale * 3.5, 2), h.t, h.d >= K - 0.1); // K (kalınlık) kadar veya fazlaysa boydan
                }).ToList();
            }

            double avgZ = (pts[0].sz + pts[1].sz + pts[2].sz + pts[3].sz) / 4;
            list.Add(new Yuz3d(pts.Select(p => p.sx).ToArray(),
                               pts.Select(p => p.sy).ToArray(),
                               avgZ, fill, stroke, sw, lbl, pW, pH, projectedHoles));
        }

        // Birlestirme Verileri
        var c = birlestirmeler.FirstOrDefault(x => x.SistemTipi == "MİNİFİKS" && x.IslemTipi == "ÇANAK") ?? new Birlestirme { XOfset = 9.5, YOfset = 37, Capi = 15 };
        var ym = birlestirmeler.FirstOrDefault(x => x.SistemTipi == "MİNİFİKS" && x.IslemTipi == "YATAY MİL") ?? new Birlestirme { XOfset = 9.5, YOfset = 82, Capi = 8 };
        var yd = birlestirmeler.FirstOrDefault(x => x.SistemTipi == "MİNİFİKS" && x.IslemTipi == "YATAY DÜBEL") ?? new Birlestirme { XOfset = 9.5, YOfset = 128, Capi = 8 };
        var sm = birlestirmeler.FirstOrDefault(x => x.SistemTipi == "MİNİFİKS" && x.IslemTipi == "YÜZEY MİL") ?? new Birlestirme { XOfset = 9.5, YOfset = 82, Capi = 8 };
        var sd = birlestirmeler.FirstOrDefault(x => x.SistemTipi == "MİNİFİKS" && x.IslemTipi == "YÜZEY DÜBEL") ?? new Birlestirme { XOfset = 9.5, YOfset = 128, Capi = 8 };
        // Tek hat (Z ekseni) düzeni: tüm C/M/D ve SM/SD aynı X ofsetini kullanır
        double satirOf = c.XOfset;

        // Montaj tipine göre dış parçaların boyut ve konumlarını hesapla
        double altW = W, ustW = W;
        double solH = H, sagH = H;
        double altX = 0, ustX = 0;
        double solY = 0, sagY = 0;

        if (montajTipi == "Alt-Üst İçeride")
        {
            altW = W - 2 * K; altX = K;
            ustW = W - 2 * K; ustX = K;
        }
        else if (montajTipi == "Alt-Üst Dışarıda")
        {
            solH = H - 2 * K; solY = K;
            sagH = H - 2 * K; sagY = K;
        }
        else if (montajTipi == "Alt İçeride-Üst Dışarıda")
        {
            altW = W - 2 * K; altX = K;
            solH = H - K;     solY = 0;
            sagH = H - K;     sagY = 0;
        }
        else // Alt Dışarıda-Üst İçeride
        {
            ustW = W - 2 * K; ustX = K;
            solH = H - K;     solY = K;
            sagH = H - K;     sagY = K;
        }

        // --- DELİK HESAPLAMALARI ---
        // Karışık montaj tiplerinde SOL/SAĞ delikleri panelin alt/üst kenarlarında, Z (önden arkaya) boyunca dizilir.
        bool karisikMontaj = montajTipi == "Alt İçeride-Üst Dışarıda" || montajTipi == "Alt Dışarıda-Üst İçeride";

        var pAlt = new Parca { En = altW, Boy = D, Kalinlik = K };
        var pUst = new Parca { En = ustW, Boy = D, Kalinlik = K };
        var pSol = karisikMontaj
            ? new Parca { En = D, Boy = solH, Kalinlik = K }
            : new Parca { En = solH, Boy = D, Kalinlik = K };
        var pSag = karisikMontaj
            ? new Parca { En = D, Boy = sagH, Kalinlik = K }
            : new Parca { En = sagH, Boy = D, Kalinlik = K };

        DelikServisi.DelikleriHesapla(pAlt, birlestirmeler, seciliGovdeSistemTipi, "ALT", montajTipi, D);
        DelikServisi.DelikleriHesapla(pUst, birlestirmeler, seciliGovdeSistemTipi, "ÜST", montajTipi, D);
        DelikServisi.DelikleriHesapla(pSol, birlestirmeler, seciliGovdeSistemTipi, "SOL", montajTipi, D);
        DelikServisi.DelikleriHesapla(pSag, birlestirmeler, seciliGovdeSistemTipi, "SAĞ", montajTipi, D);

        // MAPPING: ALT/ÜST → d.X=cabinet X, d.Y=cabinet Z. SOL/SAĞ pure → d.X=cabinet Y, d.Y=cabinet Z. SOL/SAĞ karışık → d.X=cabinet Z, d.Y=cabinet Y.
        var hAlt = pAlt.Delikler.Select(d => (d.X + altX, 0.0, d.Y, d.Cap/2, d.Tip, d.Derinlik)).ToList();
        var hUst = pUst.Delikler.Select(d => (d.X + ustX, H, d.Y, d.Cap/2, d.Tip, d.Derinlik)).ToList();
        var hSol = karisikMontaj
            ? pSol.Delikler.Select(d => (0.0, d.Y + solY, d.X, d.Cap/2, d.Tip, d.Derinlik)).ToList()
            : pSol.Delikler.Select(d => (0.0, d.X + solY, d.Y, d.Cap/2, d.Tip, d.Derinlik)).ToList();
        var hSag = karisikMontaj
            ? pSag.Delikler.Select(d => (W, d.Y + sagY, d.X, d.Cap/2, d.Tip, d.Derinlik)).ToList()
            : pSag.Delikler.Select(d => (W, d.X + sagY, d.Y, d.Cap/2, d.Tip, d.Derinlik)).ToList();

        // 4 dış ana yüz (Cross/Haç biçimli dizilim)
        Ekle("#FFF9C4","#777",1.2, "ALT TABLA", D, altW, (altX,0,0),(altX+altW,0,0),(altX+altW,0,D),(altX,0,D), 0, -1, 0,  1,  0, "yatay", hAlt);
        Ekle("#FFF9C4","#777",1.2, "ÜST TABLA", D, ustW, (ustX,H,0),(ustX,H,D),(ustX+ustW,H,D),(ustX+ustW,H,0), 0,  1, 0, -1,  0, "yatay", hUst);
        Ekle("#FFCDD2","#777",1.2, "SOL YAN", D, solH, (0,solY,0),(0,solY,D),(0,solY+solH,D),(0,solY+solH,0), -1, 0, 0, -1,  0, "dikey_yan", hSol);
        Ekle("#FFCDD2","#777",1.2, "SAĞ YAN", D, sagH, (W,sagY,0),(W,sagY+sagH,0),(W,sagY+sagH,D),(W,sagY,D),  1, 0, 0,  1,  0, "dikey_yan", hSag);

        // Panellerin iç yüzeyleri ve kenar kalınlıkları (sadece normal 3D modunda görünür)
        if (nestingFaktoru <= 1)
        {
            // Dinamik ön yüz panelleri (kalınlık kenarları)
            Ekle("#FFF9C4","#777",0.8, "", 0, 0, (ustX,H-K,0),(ustX+ustW,H-K,0),(ustX+ustW,H,0),(ustX,H,0)); // Üst ön
            Ekle("#FFF9C4","#777",0.8, "", 0, 0, (altX,0,0),(altX+altW,0,0),(altX+altW,K,0),(altX,K,0)); // Alt ön
            Ekle("#FFCDD2","#777",0.8, "", 0, 0, (0,solY,0),(K,solY,0),(K,solY+solH,0),(0,solY+solH,0)); // Sol ön
            Ekle("#FFCDD2","#777",0.8, "", 0, 0, (W-K,sagY,0),(W,sagY,0),(W,sagY+sagH,0),(W-K,sagY+sagH,0)); // Sağ ön
        }

        // Raflar (Genişlik her zaman iç genişlik kadardır)
        double icW = W - 2 * K;
        double icH = H - 2 * K;

        for (int i = 1; i <= rafSayisi; i++)
        {
            double ry = K + (i / (double)(rafSayisi + 1)) * icH;
            double nzOffset = -1.2 - (i - 1) * 1.1; 

            var pRaf = new Parca { En = icW, Boy = D - 2*K, Kalinlik = K };
            DelikServisi.DelikleriHesapla(pRaf, birlestirmeler, seciliDikmeSistemTipi, "RAF", montajTipi, D);
            var hRaf = pRaf.Delikler.Select(d => (d.X + K, ry, d.Y + K, d.Cap/2, d.Tip, d.Derinlik)).ToList();

            Ekle("#C8E6C9","#777",0.5, "RAF PANEL " + i, D-K, icW, (K,ry,K),(K+icW,ry,K),(K+icW,ry,D-K),(K,ry,D-K), 0, 0, 0.5, 1.8, nzOffset, "yatay", hRaf);
            if (nestingFaktoru <= 1)
                Ekle("#C8E6C9","#777",0.5, "", 0, 0, (K,ry-K,K),(K+icW,ry-K,K),(K+icW,ry,K),(K,ry,K));

            // Yanlara raf bağlantı deliklerini ekle (yüzey delikleri)
            var pYanYuzey = new Parca { En = D, Boy = K, Kalinlik = K };
            DelikServisi.DelikleriHesapla(pYanYuzey, birlestirmeler, seciliDikmeSistemTipi, "SOL", "Alt-Üst İçeride", D);
            foreach (var d in pYanYuzey.Delikler.Where(x => x.Tip.StartsWith("S")))
            {
                hSol.Add((0.0, ry + (d.Y == satirOf ? satirOf : -satirOf), d.X, d.Cap/2, d.Tip, d.Derinlik));
                hSag.Add((W, ry + (d.Y == satirOf ? satirOf : -satirOf), d.X, d.Cap/2, d.Tip, d.Derinlik));
            }
        }

        // Dikmeler (Yükseklik her zaman iç yükseklik kadardır)
        for (int i = 1; i <= dikmeSayisi; i++)
        {
            double dk = K + (i / (double)(dikmeSayisi + 1)) * icW;
            double nxOffset = -1.8 - (i - 1) * 1.3;

            var pDikme = new Parca { En = icH, Boy = D - 2*K, Kalinlik = K };
            DelikServisi.DelikleriHesapla(pDikme, birlestirmeler, seciliDikmeSistemTipi, "DİKME", montajTipi, D);
            var hDikme = pDikme.Delikler.Select(d => (dk, d.X + K, d.Y + K, d.Cap/2, d.Tip, d.Derinlik)).ToList();

            Ekle("#BBDEFB","#777",0.5, "DİKME PANEL " + i, D-K*2, icH, (dk,K,K),(dk,K,D-K),(dk,K+icH,D-K),(dk,K+icH,K), 0, 0, 0.5, nxOffset, 1.2, "dikey_yan", hDikme);
            
            if (nestingFaktoru <= 1)
                Ekle("#BBDEFB","#777",0.5, "", 0, 0, (dk,K,K),(dk+K,K,K),(dk+K,K+icH,K),(dk,K+icH,K));
        }

        list.Sort((a, b) => b.AvgZ.CompareTo(a.AvgZ));
        if (nestingFaktoru > 1) return list.Where(x => !string.IsNullOrEmpty(x.Label)).ToList();
        return list;
    }

    private record DolapBoyut(double X, double Y, double W, double H, double K);

    private DolapBoyut DolapHesapla()
    {
        const double svgW = 800, svgH = 600, kenar = 80;
        double kulW = svgW - kenar * 2;
        double kulH = svgH - kenar * 2;
        double oran  = genislik / yukseklik;
        double w, h;
        if (kulW / kulH > oran) { h = kulH; w = h * oran; }
        else                    { w = kulW; h = w / oran; }
        double x = (svgW - w) / 2;
        double y = (svgH - h) / 2;
        double k = Math.Max((kalinlikMm / genislik) * w, 5.0);
        return new DolapBoyut(x, y, w, h, k);
    }

    private async Task GKoduCikar()
    {
        double W = genislik, H = yukseklik, D = derinlik, K = kalinlikMm;
        double icW = W - 2 * K;
        double icH = H - 2 * K;
        bool karisikMontaj = montajTipi == "Alt İçeride-Üst Dışarıda" || montajTipi == "Alt Dışarıda-Üst İçeride";

        double altW = W, ustW = W, solH = H, sagH = H;
        if (montajTipi == "Alt-Üst İçeride") { altW = W - 2 * K; ustW = W - 2 * K; }
        else if (montajTipi == "Alt-Üst Dışarıda") { solH = H - 2 * K; sagH = H - 2 * K; }
        else if (montajTipi == "Alt İçeride-Üst Dışarıda") { altW = W - 2 * K; solH = H - K; sagH = H - K; }
        else { ustW = W - 2 * K; solH = H - K; sagH = H - K; }

        var pAlt = new Parca { Ad = "alt_tabla", En = altW, Boy = D, Kalinlik = K };
        var pUst = new Parca { Ad = "ust_tabla", En = ustW, Boy = D, Kalinlik = K };
        var pSol = karisikMontaj
            ? new Parca { Ad = "sol_yan", En = D, Boy = solH, Kalinlik = K }
            : new Parca { Ad = "sol_yan", En = solH, Boy = D, Kalinlik = K };
        var pSag = karisikMontaj
            ? new Parca { Ad = "sag_yan", En = D, Boy = sagH, Kalinlik = K }
            : new Parca { Ad = "sag_yan", En = sagH, Boy = D, Kalinlik = K };

        DelikServisi.DelikleriHesapla(pAlt, birlestirmeler, seciliGovdeSistemTipi, "ALT", montajTipi, D);
        DelikServisi.DelikleriHesapla(pUst, birlestirmeler, seciliGovdeSistemTipi, "ÜST", montajTipi, D);
        DelikServisi.DelikleriHesapla(pSol, birlestirmeler, seciliGovdeSistemTipi, "SOL", montajTipi, D);
        DelikServisi.DelikleriHesapla(pSag, birlestirmeler, seciliGovdeSistemTipi, "SAĞ", montajTipi, D);

        var parcalar = new List<Parca> { pAlt, pUst, pSol, pSag };

        for (int i = 1; i <= rafSayisi; i++)
        {
            var pRaf = new Parca { Ad = $"raf_{i}", En = icW, Boy = D - 2 * K, Kalinlik = K };
            DelikServisi.DelikleriHesapla(pRaf, birlestirmeler, seciliDikmeSistemTipi, "RAF", montajTipi, D);
            parcalar.Add(pRaf);
        }

        for (int i = 1; i <= dikmeSayisi; i++)
        {
            var pDikme = new Parca { Ad = $"dikme_{i}", En = icH, Boy = D - 2 * K, Kalinlik = K };
            DelikServisi.DelikleriHesapla(pDikme, birlestirmeler, seciliDikmeSistemTipi, "DİKME", montajTipi, D);
            parcalar.Add(pDikme);
        }

        var uretici = new Shared.Servisler.GKodUretici();
        var jsParam = parcalar
            .Select(p => (object)new { ad = uretici.DosyaAdiOlustur(p), icerik = uretici.GKodUret(p, takimlar, birlestirmeler) })
            .ToArray();

        try
        {
            var sonuc = await JSRuntime.InvokeAsync<System.Text.Json.JsonElement>("gkodDosyalariniKaydet", (object)jsParam);
            bool basari = sonuc.GetProperty("basari").GetBoolean();
            string mesaj = sonuc.GetProperty("mesaj").GetString() ?? "";
            if (basari)
                Snackbar.Add(mesaj, Severity.Success);
            else if (mesaj != "İptal edildi")
                Snackbar.Add($"Hata: {mesaj}", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"G-kodu hatası: {ex.Message}", Severity.Error);
        }
    }

    private static string DelikTipiAdi(string tip) => tip switch
    {
        "C"  => "ÇANAK",
        "SM" => "YÜZEY MİL",
        "SD" => "YÜZEY DÜBEL",
        "M"  => "YATAY MİL",
        "D"  => "YATAY DÜBEL",
        "RP" => "RAF PİMİ",
        _    => tip
    };

    private async Task ImalatVeritabaninaKaydet()
    {
        double W = genislik, H = yukseklik, D = derinlik, K = kalinlikMm;
        double icW = W - 2 * K;
        double icH = H - 2 * K;
        bool karisikMontaj = montajTipi == "Alt İçeride-Üst Dışarıda" || montajTipi == "Alt Dışarıda-Üst İçeride";

        double altW = W, ustW = W, solH = H, sagH = H;
        if      (montajTipi == "Alt-Üst İçeride")          { altW = W - 2 * K; ustW = W - 2 * K; }
        else if (montajTipi == "Alt-Üst Dışarıda")         { solH = H - 2 * K; sagH = H - 2 * K; }
        else if (montajTipi == "Alt İçeride-Üst Dışarıda") { altW = W - 2 * K; solH = H - K; sagH = H - K; }
        else                                                 { ustW = W - 2 * K; solH = H - K; sagH = H - K; }

        var pAlt = new Parca { Ad = "alt_tabla", En = altW, Boy = D, Kalinlik = K };
        var pUst = new Parca { Ad = "ust_tabla", En = ustW, Boy = D, Kalinlik = K };
        var pSol = karisikMontaj
            ? new Parca { Ad = "sol_yan", En = D, Boy = solH, Kalinlik = K }
            : new Parca { Ad = "sol_yan", En = solH, Boy = D, Kalinlik = K };
        var pSag = karisikMontaj
            ? new Parca { Ad = "sag_yan", En = D, Boy = sagH, Kalinlik = K }
            : new Parca { Ad = "sag_yan", En = sagH, Boy = D, Kalinlik = K };

        DelikServisi.DelikleriHesapla(pAlt, birlestirmeler, seciliGovdeSistemTipi, "ALT", montajTipi, D);
        DelikServisi.DelikleriHesapla(pUst, birlestirmeler, seciliGovdeSistemTipi, "ÜST", montajTipi, D);
        DelikServisi.DelikleriHesapla(pSol, birlestirmeler, seciliGovdeSistemTipi, "SOL", montajTipi, D);
        DelikServisi.DelikleriHesapla(pSag, birlestirmeler, seciliGovdeSistemTipi, "SAĞ", montajTipi, D);

        var sonuc = new List<ParcaDelikKoordinati>();

        void DelikleriEkle(string ad, Parca p)
        {
            foreach (var d in p.Delikler)
                sonuc.Add(new ParcaDelikKoordinati
                {
                    ParcaAdi = ad,
                    DelikTipi = DelikTipiAdi(d.Tip),
                    XKoordinat = d.X,
                    YKoordinat = d.Y,
                    ZKoordinat = 0,
                    Cap = d.Cap,
                    Derinlik = d.Derinlik
                });
        }

        DelikleriEkle("alt_tabla", pAlt);
        DelikleriEkle("ust_tabla", pUst);
        DelikleriEkle("sol_yan", pSol);
        DelikleriEkle("sag_yan", pSag);

        for (int i = 1; i <= rafSayisi; i++)
        {
            var pRaf = new Parca { Ad = $"raf_{i}", En = icW, Boy = D - 2 * K, Kalinlik = K };
            DelikServisi.DelikleriHesapla(pRaf, birlestirmeler, seciliDikmeSistemTipi, "RAF", montajTipi, D);
            DelikleriEkle($"raf_{i}", pRaf);
        }

        for (int i = 1; i <= dikmeSayisi; i++)
        {
            var pDikme = new Parca { Ad = $"dikme_{i}", En = icH, Boy = D - 2 * K, Kalinlik = K };
            DelikServisi.DelikleriHesapla(pDikme, birlestirmeler, seciliDikmeSistemTipi, "DİKME", montajTipi, D);
            DelikleriEkle($"dikme_{i}", pDikme);
        }

        parcaDelikKoordinatlari = sonuc;

        try
        {
            await SupabaseClient.From<ParcaDelikKoordinati>()
                .Filter("id", Operator.GreaterThan, "0")
                .Delete();

            if (parcaDelikKoordinatlari.Any())
                await SupabaseClient.From<ParcaDelikKoordinati>().Insert(parcaDelikKoordinatlari);

            Snackbar.Add($"{parcaDelikKoordinatlari.Count} delik koordinatı veritabanına kaydedildi", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Kayıt hatası: {ex.Message}", Severity.Error);
        }
    }
