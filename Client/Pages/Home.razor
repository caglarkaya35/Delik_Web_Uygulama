    private string seciliGovdeSistemTipi = "MİNİFİKS";
    private string seciliDikmeSistemTipi = "MİNİFİKS";

    private async Task PatlatilmisGorunumuBaslat()
    {
        var parameters = new DialogParameters<BirlestirmeDialog>
        {
            { x => x.GovdeSistemTipi, seciliGovdeSistemTipi },
            { x => x.DikmeSistemTipi, seciliDikmeSistemTipi }
        };

        var dialog = await DialogService.ShowAsync<BirlestirmeDialog>("", parameters);
        var result = await dialog.Result;

        if (result == null || result.Canceled) return;

        if (result.Data is (string govde, string dikme))
        {
            seciliGovdeSistemTipi = govde;
            seciliDikmeSistemTipi = dikme;
        }

        aktifMenu = "imalat";
        gorunum3D = true;
        rotX3d = 0.615;
        rotY3d = 0.785;
        patlatmaFaktoru = 0;
        nestingFaktoru = 0;

        // 1. Aşama: Patlatma
        for (int i = 0; i <= 15; i++)
        {
            patlatmaFaktoru = i * 6;
            StateHasChanged();
            await Task.Delay(30);
        }

        // 2. Aşama: Üstten bakışa dön ve yere ser
        double startX = rotX3d;
        double startY = rotY3d;
        for (int i = 1; i <= 20; i++)
        {
            double t = i / 20.0;
            rotX3d = startX + (Math.PI / 2 - startX) * t;
            rotY3d = startY + (0 - startY) * t;
            nestingFaktoru = t * 100;
            StateHasChanged();
            await Task.Delay(30);
        }
    }
    private void CizimiKapat()
    {
        patlatmaFaktoru = 0;
        nestingFaktoru = 0;
        gorunum3D = false;
        StateHasChanged();
    }

    private void SetView(double x, double y)
    {
        rotX3d = x;
        rotY3d = y;
    }

    private void OnWheel2d(WheelEventArgs e) =>
        zoom2d = Math.Clamp(zoom2d * (e.DeltaY < 0 ? 1.12 : 1 / 1.12), 0.15, 8.0);

    private void OnWheel3d(WheelEventArgs e) =>
        zoom3d = Math.Clamp(zoom3d * (e.DeltaY < 0 ? 1.12 : 1 / 1.12), 0.15, 8.0);

    private void Md3d(MouseEventArgs e) { arrDragging = true; arrLastX = e.ClientX; arrLastY = e.ClientY; }
    private void Mm3d(MouseEventArgs e)
    {
        if (!arrDragging) return;
        rotY3d += (e.ClientX - arrLastX) * 0.008;
        rotX3d -= (e.ClientY - arrLastY) * 0.008;
        rotX3d   = Math.Clamp(rotX3d, -1.4, 1.4);
        arrLastX = e.ClientX; arrLastY = e.ClientY;
    }
    private void Mu3d(MouseEventArgs e) => arrDragging = false;

    private string PerspektifEtiketi()
    {
        double xDeg = rotX3d * 180 / Math.PI;
        double yDeg = (rotY3d * 180 / Math.PI) % 360;
        if (yDeg < 0) yDeg += 360;

        if (xDeg > 60) return "TOP";
        if (xDeg < -60) return "BOTTOM";

        // Y açısına göre pusula yönleri
        if (yDeg >= 337.5 || yDeg < 22.5) return "FRONT";
        if (yDeg >= 22.5 && yDeg < 67.5) return "SW";
        if (yDeg >= 67.5 && yDeg < 112.5) return "LEFT";
        if (yDeg >= 112.5 && yDeg < 157.5) return "NW";
        if (yDeg >= 157.5 && yDeg < 202.5) return "BACK";
        if (yDeg >= 202.5 && yDeg < 247.5) return "NE";
        if (yDeg >= 247.5 && yDeg < 292.5) return "RIGHT";
        if (yDeg >= 292.5 && yDeg < 337.5) return "SE";

        return "CUSTOM";
    }

