    private static string N(double v) =>
        v.ToString("F2", CultureInfo.InvariantCulture);

    private void GorunumDegistir() 
    { 
        gorunum3D = !gorunum3D;
        if (gorunum3D)
        {
            rotX3d = 0.615;
            rotY3d = 0.785;
        }
    }
